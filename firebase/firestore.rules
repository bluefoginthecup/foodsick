rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'deleting'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('sessionVersion', null) == request.auth.token.get('sessionVersion', null);
    }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isOwner(data) { return signedIn() && data.ownerUid == request.auth.uid; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data) || isAdmin();
      allow create, update, delete: if false;
    }

    match /companionObservations/{observationId} {
      allow read: if isOwner(resource.data) || isAdmin();
      allow create, update, delete: if false;
    }

    match /{privateCollection}/{document=**} {
      allow read, write: if false;
    }
  }
}
